<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fundamentals of Network Theory — Exercises</title>
  <!-- Include Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="font-sans text-gray-800 bg-white p-5">    
  <div class="max-w-4xl mx-auto">
    <!-- Header -->
    <header class="bg-gray-100 p-6 text-center rounded-lg mb-6">
      <div class="flex flex-wrap items-center justify-center gap-8 mb-3">
        <img src="data:image/png;base64," alt="University of Luxembourg — FSTM" class="w-44 h-auto">
        <img src="data:image/png;base64," alt="SECAN-Lab" class="w-44 h-auto">
      </div>
      <h1 class="text-2xl font-bold mb-2">Fundamentals of Network Theory</h1>
      <p class="text-sm">Hands-on exercise notebooks &middot; SECAN-Lab, University of Luxembourg &middot; Winter 2026/27</p>
    </header>

    <main>
      {% if notebooks %}
      <h2 class="text-xl font-bold text-center my-4">Exercises</h2>
      <p class="text-center mb-4">Work directly in your browser &mdash; nothing to install. Download your notebook (.py) after each session and submit it together with a PDF via Moodle.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
        {% for notebook in notebooks %}
        <!-- {{ notebook.display_name }} Notebook -->
        <div class="bg-gray-50 border border-gray-200 rounded-lg overflow-hidden">
          <div class="bg-gray-200 p-3 font-semibold">{{ notebook.display_name }}</div>
          <div class="p-4">
            <a href="{{ notebook.html_path }}" class="inline-block bg-blue-500 hover:bg-blue-600 text-white py-1 px-3 rounded transition-colors">Open Notebook</a>
          </div>
        </div>
        {% endfor %}
      </div>
      {% endif %}

      {% if apps %}
      <h2 class="text-xl font-bold text-center my-4">Demos</h2>
      <p class="text-center mb-4">Interactive lecture demos &mdash; code is hidden for a clean interface</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {% for app in apps %}
        <!-- {{ app.display_name }} App -->
        <div class="bg-gray-50 border border-gray-200 rounded-lg overflow-hidden">
          <div class="bg-gray-100 p-3 font-semibold">{{ app.display_name }}</div>
          <div class="p-4">
            <a href="{{ app.html_path }}" class="inline-block bg-amber-500 hover:bg-amber-600 text-white py-1 px-3 rounded transition-colors">Open App</a>
          </div>
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </main>

    <footer class="mt-10 pt-6 border-t border-gray-200 text-center text-sm text-gray-600">
      <p class="mb-2">Fundamentals of Network Theory (Prof. Dr. Thomas Engel) &middot; Exercise track by Felix Saretzky<br>Built with <a href="https://marimo.io" target="_blank" class="text-blue-500 hover:underline">marimo</a> &mdash; interactive Python notebooks</p>
    </footer>
  </div>
</body>
</html>